<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <!-- The Fullscreen Hardware Accelerated Terminal Surface with Native Inline Input -->
    <com.hybridengine.terminal.TerminalSurfaceView
        android:id="@+id/terminal_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Agent HUD Floating Overlay Banner -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_agent_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="80dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="#E61E1E2E"
        app:cardCornerRadius="8dp"
        app:cardElevation="6dp"
        app:strokeColor="#44475A"
        app:strokeWidth="1dp"
        app:contentPadding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/text_hud_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● AGENT ACTIVE"
                    android:textColor="#50FA7B"
                    android:textStyle="bold"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_hud_agent_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Agent"
                    android:textColor="#BD93F9"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:singleLine="true" />

                <ImageView
                    android:id="@+id/btn_hud_dismiss"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Dismiss HUD"
                    android:tint="#6272A4"
                    android:src="@android:drawable/ic_menu_close_clear_cancel" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_hud_thought"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#F8F8F2"
                android:textSize="12sp"
                android:maxLines="2" />

            <TextView
                android:id="@+id/text_hud_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#8BE9FD"
                android:textSize="10sp"
                android:singleLine="true"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progress_hud"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:progressTint="#BD93F9"
                android:indeterminateTint="#BD93F9"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Action Button to launch Native Settings -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:contentDescription="Settings"
        app:backgroundTint="#44475A"
        app:tint="#F8F8F2"
        app:fabSize="mini"
        app:srcCompat="@drawable/ic_settings" />

</FrameLayout>
